@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor Cliente as cliente
actor Administrador as admin
actor Auxiliar as auxiliar
actor "Sistema de Pagos" as pagos
actor "Sistema de Envío" as envio
actor "Sistema de Soporte" as soporte

rectangle "YESA E-Commerce" {
  package "Autenticación y Perfil" {
    usecase "Registrarse" as UC01
    usecase "Iniciar sesión" as UC02
    usecase "Recuperar contraseña" as UC03
    usecase "Gestionar perfil" as UC04
  }

  package "Catálogo y Compras" {
    usecase "Explorar catálogo" as UC05
    usecase "Ver detalle de producto" as UC06
    usecase "Gestionar carrito" as UC07
    usecase "Realizar checkout" as UC08
    usecase "Crear pedido" as UC09
    usecase "Consultar pedidos" as UC10
    usecase "Cancelar pedido" as UC11
    usecase "Gestionar favoritos" as UC12
    usecase "Solicitar cotización" as UC13
  }

  package "Soporte y Atención" {
    usecase "Enviar consulta" as UC14
    usecase "Consultar historial de soporte" as UC15
    usecase "Responder consulta" as UC16
    usecase "Cerrar caso de soporte" as UC17
  }

  package "Administración" {
    usecase "Gestionar usuarios" as UC18
    usecase "Gestionar productos" as UC19
    usecase "Gestionar categorías" as UC20
    usecase "Gestionar subcategorías" as UC21
    usecase "Gestionar pedidos" as UC22
    usecase "Gestionar cotizaciones" as UC23
    usecase "Gestionar inventario" as UC24
    usecase "Consultar métricas y reportes" as UC25
    usecase "Configurar sistema" as UC26
    usecase "Auditar acciones" as UC27
  }

  UC02 <.. UC03 : <<extend>>
  UC08 <.. UC09 : <<extend>>
  UC09 ..> UC02 : <<include>>
  UC09 ..> UC08 : <<include>>
  UC10 ..> UC02 : <<include>>
  UC11 ..> UC10 : <<extend>>
  UC13 ..> UC02 : <<include>>
  UC14 ..> UC02 : <<include>>
  UC16 ..> UC15 : <<extend>>
  UC17 ..> UC16 : <<extend>>
  UC18 ..> UC02 : <<include>>
  UC19 ..> UC02 : <<include>>
  UC20 ..> UC02 : <<include>>
  UC21 ..> UC02 : <<include>>
  UC22 ..> UC02 : <<include>>
  UC23 ..> UC02 : <<include>>
  UC24 ..> UC19 : <<extend>>
  UC25 ..> UC02 : <<include>>
  UC26 ..> UC02 : <<include>>
  UC27 ..> UC18 : <<extend>>
}

cliente --> UC01
cliente --> UC02
cliente --> UC03
cliente --> UC04
cliente --> UC05
cliente --> UC06
cliente --> UC07
cliente --> UC08
cliente --> UC09
cliente --> UC10
cliente --> UC11
cliente --> UC12
cliente --> UC13
cliente --> UC14
cliente --> UC15

auxiliar --> UC02
auxiliar --> UC10
auxiliar --> UC14
auxiliar --> UC15
auxiliar --> UC22
auxiliar --> UC23

admin --> UC02
admin --> UC18
admin --> UC19
admin --> UC20
admin --> UC21
admin --> UC22
admin --> UC23
admin --> UC24
admin --> UC25
admin --> UC26
admin --> UC27

pagos --> UC08
pagos --> UC09
pagos --> UC13

envio --> UC09
envio --> UC10
envio --> UC11

soporte --> UC14
soporte --> UC16
soporte --> UC17
@enduml
