@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor Administrador as admin

rectangle "Dashboard Administrativo" {
  package "Autenticación y Seguridad" {
    usecase "Iniciar sesión de administrador" as UC01
    usecase "Gestionar sesión" as UC02
    usecase "Gestionar permisos" as UC03
  }

  package "Gestión de Usuarios" {
    usecase "Listar usuarios" as UC04
    usecase "Crear usuario" as UC05
    usecase "Editar usuario" as UC06
    usecase "Activar/Desactivar usuario" as UC07
    usecase "Eliminar usuario" as UC08
  }

  package "Catálogo y Inventario" {
    usecase "Gestionar categorías" as UC09
    usecase "Gestionar subcategorías" as UC10
    usecase "Gestionar productos" as UC11
    usecase "Actualizar stock" as UC12
    usecase "Gestionar precios" as UC13
  }

  package "Pedidos y Cotizaciones" {
    usecase "Listar pedidos" as UC14
    usecase "Ver detalle de pedido" as UC15
    usecase "Actualizar estado de pedido" as UC16
    usecase "Gestionar cotizaciones" as UC17
    usecase "Aprobar o rechazar cotización" as UC18
  }

  package "Reportes y Auditoría" {
    usecase "Consultar dashboard" as UC19
    usecase "Ver métricas de ventas" as UC20
    usecase "Ver métricas de usuarios" as UC21
    usecase "Generar reportes" as UC22
    usecase "Auditar acciones del sistema" as UC23
  }

  package "Configuración y Soporte" {
    usecase "Configurar parámetros del sistema" as UC24
    usecase "Gestionar contenido de soporte" as UC25
    usecase "Responder solicitudes de soporte" as UC26
  }

  UC01 <.. UC02 : <<extend>>
  UC04 ..> UC01 : <<include>>
  UC05 ..> UC04 : <<include>>
  UC06 ..> UC04 : <<include>>
  UC07 ..> UC04 : <<include>>
  UC08 ..> UC04 : <<include>>

  UC09 ..> UC01 : <<include>>
  UC10 ..> UC09 : <<extend>>
  UC11 ..> UC01 : <<include>>
  UC12 ..> UC11 : <<extend>>
  UC13 ..> UC11 : <<extend>>

  UC14 ..> UC01 : <<include>>
  UC15 ..> UC14 : <<extend>>
  UC16 ..> UC15 : <<extend>>
  UC17 ..> UC01 : <<include>>
  UC18 ..> UC17 : <<extend>>

  UC19 ..> UC01 : <<include>>
  UC20 ..> UC19 : <<extend>>
  UC21 ..> UC19 : <<extend>>
  UC22 ..> UC19 : <<extend>>
  UC23 ..> UC19 : <<extend>>

  UC24 ..> UC01 : <<include>>
  UC25 ..> UC01 : <<include>>
  UC26 ..> UC25 : <<extend>>
}

admin --> UC01
admin --> UC04
admin --> UC09
admin --> UC11
admin --> UC14
admin --> UC17
admin --> UC19
admin --> UC24
admin --> UC25
@enduml
