const fs = require('fs');
const path = require('path');

const ROOT = process.cwd();
const excludeDirs = ['node_modules', 'dist', 'build', 'coverage', '.git', 'public', 'app_movil/dist', 'backend/coverage', 'App/dist', 'app/dist'];
const exts = ['.js', '.jsx', '.ts', '.tsx'];

function shouldExclude(dir) {
  return excludeDirs.some(d => dir.includes(path.sep + d + path.sep) || dir.endsWith(path.sep + d));
}

function walk(dir, cb) {
  if (shouldExclude(dir)) return;
  const entries = fs.readdirSync(dir, { withFileTypes: true });
  for (const ent of entries) {
    const full = path.join(dir, ent.name);
    if (ent.isDirectory()) {
      if (shouldExclude(full)) continue;
      walk(full, cb);
    } else if (ent.isFile()) {
      if (exts.includes(path.extname(ent.name))) cb(full);
    }
  }
}

function replaceStandalone(content, name, replacement) {
  let i = content.indexOf(name + '(');
  while (i !== -1) {
    // Check preceding few chars for 'Number.'
    const before = content.slice(Math.max(0, i - 7), i);
    if (!/Number\.$/.test(before)) {
      content = content.slice(0, i) + replacement + content.slice(i + name.length + 1);
      i = content.indexOf(name + '(', i + replacement.length);
    } else {
      i = content.indexOf(name + '(', i + name.length + 1);
    }
  }
  return content;
}

const filesChanged = [];

walk(ROOT, (file) => {
  const rel = path.relative(ROOT, file).replace(/\\/g, '/');
  // Skip known build/minified files by heuristic
  if (/\.min\.|\/dist\//.test(rel)) return;
  const text = fs.readFileSync(file, 'utf8');
  let updated = text;

  // Replace parseInt/parseFloat (safe to always prefix)
  updated = updated.replace(/\bparseInt\(/g, 'Number.parseInt(');
  updated = updated.replace(/\bparseFloat\(/g, 'Number.parseFloat(');

  // Replace isNaN/isFinite only when not already Number.isNaN / Number.isFinite
  updated = replaceStandalone(updated, 'isNaN', 'Number.isNaN');
  updated = replaceStandalone(updated, 'isFinite', 'Number.isFinite');

  if (updated !== text) {
    // backup
    try {
      fs.writeFileSync(file + '.bak', text, 'utf8');
      fs.writeFileSync(file, updated, 'utf8');
      filesChanged.push(rel);
    } catch (err) {
      console.error('Failed to write', file, err);
    }
  }
});

console.log('Replaced Number methods in files:', filesChanged.length);
filesChanged.forEach(f => console.log('  -', f));

if (filesChanged.length === 0) process.exit(0);
else process.exit(0);
